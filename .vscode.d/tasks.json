{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Create Python environment (pip)",
            "detail": "Create .venv with the installed Python and pip, then install the model-export dependencies",
            "type": "shell",
            "command": "./setup_venv.sh",
            "windows": {
                "command": ".\\setup_venv.bat"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Create Python environment (uv)",
            "detail": "Create .venv with uv, optionally downloading the selected Python version; requires uv on PATH",
            "type": "shell",
            "command": "./setup_venv.sh",
            "windows": {
                "command": ".\\setup_venv.bat"
            },
            "args": ["--uv", "--python", "${input:setupPythonVersion}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Create AI layer",
            "detail": "Export model/model.py for the active solution's NPU and write ai_layer (run 'cbuild setup' first)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "create_ai_layer.py",
                "${command:cmsis-csolution.getSolutionName}.cbuild-mlops.yml"
            ],
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Alif: Install M55_HE or M55_HP debug stubs (single core configuration)",
            "type": "shell",
            "command": [
                "Copy-Item -LiteralPath './.alif/M55_HE_mram_cfg.json' -Destination '${config:alif.setools.root}/build/config/M55_HE_mram_cfg.json';",
                "Copy-Item -LiteralPath './.alif/M55_HP_mram_cfg.json' -Destination '${config:alif.setools.root}/build/config/M55_HP_mram_cfg.json';",
                "Copy-Item -LiteralPath './.alif/M55_HP_mram_stub.bin' -Destination '${config:alif.setools.root}/build/images/M55_HP_mram_stub.bin';",
                "Copy-Item -LiteralPath './.alif/M55_HE_mram_stub.bin' -Destination '${config:alif.setools.root}/build/images/M55_HE_mram_stub.bin';",
                "Set-Location -LiteralPath '${config:alif.setools.root}';",
                "./app-gen-toc -f 'build/config/${command:cmsis-csolution.getProcessorName}_mram_cfg.json';",
                "./app-write-mram -p ${input:discoverCOM};"
            ],
            "windows": {
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-Command"]
                    }
                }
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "discoverCOM",
            "type": "pickString",
            "description": "Select COM Port for SETOOLS?",
            "options": [
                {
                    "label": "Yes - Enable COM Port Discovery using command option",
                    "value": "-d"
                },
                {
                    "label": "No - COM port is already selected",
                    "value": ""
                }
            ],
            "default": ""
        },
        {
            "id": "setupPythonVersion",
            "type": "promptString",
            "description": "Python version for uv (>=3.10,<3.14), e.g. 3.12 or 3.12.10",
            "default": "3.12"
        }
    ]
}
